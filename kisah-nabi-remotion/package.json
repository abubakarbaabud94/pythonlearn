{
  "name": "kisah-nabi-remotion",
  "version": "0.1.0",
  "private": true,
  "description": "Template motion graphic seri kisah nabi (9:16) dengan Remotion",
  "scripts": {
    "ayat": "node scripts/extract-ayat.mjs",
    "studio": "remotion studio",
    "render": "remotion render Yunus out/yunus.mp4",
    "still": "remotion still Yunus out/still.png",
    "typecheck": "tsc --noEmit",
    "sinkron-vo": "node scripts/sinkron-vo.mjs --id yunus --audio voiceover/yunus-raw.mp3 --kata voiceover/yunus-words.json --tempo 1.08 --lambat 5",
    "sinkron-vo-2": "node scripts/sinkron-vo.mjs --id yunus-2 --audio voiceover/yunus-2-raw.mp3 --kata voiceover/yunus-2-words.json --tempo 1.08 --lambat 2",
    "render-2": "remotion render Yunus2 out/yunus-2.mp4",
    "sinkron-vo-zakariya": "node scripts/sinkron-vo.mjs --id zakariya --audio voiceover/zakariya-raw.mp3 --kata voiceover/zakariya-words.json --tempo 1.08 --lambat 4",
    "render-zakariya": "remotion render Zakariya out/zakariya.mp4",
    "vangogh": "node scripts/vangogh.mjs yunus --render",
    "render-vg": "remotion render YunusVG out/yunus-vangogh.mp4",
    "sfx": "python3 scripts/buat-sfx.py",
    "sheet": "node scripts/sheet.mjs"
  },
  "dependencies": {
    "@fontsource/amiri-quran": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/scheherazade-new": "5.3.0",
    "@remotion/captions": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/noise": "4.0.536",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@types/react": "19.1.12",
    "quran-json": "3.1.2",
    "typescript": "5.9.3"
  }
}
